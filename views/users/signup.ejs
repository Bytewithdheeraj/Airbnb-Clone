<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/CSS/signup.css" />

<div class="signup-page-wrapper">
    <div class="signup-bg">
        <div class="signup-card">

            <!-- Airbnb Logo -->
            <img src="/Assets/airbnb.png" class="signup-logo" alt="logo" />

            <h4 class="text-center fw-bold mb-3">Welcome to Airbnb</h4>

            <!-- Sign up with Google Button -->
            <a href="/auth/google" class="btn btn-light border w-100 py-2 mb-3 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                <img src="https://www.vectorlogo.zone/logos/google/google-icon.svg" alt="Google logo" width="18" height="18" />
                <span class="fw-semibold text-dark">Sign up with Google</span>
            </a>

            <!-- Divider with 'or' -->
            <div class="text-center position-relative my-3">
                <hr class="text-muted">
                <span class="position-absolute top-50 start-50 translate-middle px-2 bg-white text-muted small">or</span>
            </div>

            <form action="/signup" method="POST" class="needs-validation" novalidate>

                <!-- Username -->
                <div class="form-group mb-3">
                    <input
                        name="username"
                        id="username"
                        type="text"
                        placeholder="Username"
                        class="form-control form-control-lg"
                        required
                    />
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <!-- Email -->
                <div class="form-group mb-3">
                    <input
                        name="email"
                        id="email"
                        type="email"
                        placeholder="Email"
                        class="form-control form-control-lg"
                        required
                    />
                    <div class="invalid-feedback">Please enter your email.</div>
                </div>

                <!-- Password -->
                <div class="form-group mb-3">
                    <input
                        name="password"
                        id="password"
                        type="password"
                        placeholder="Password"
                        class="form-control form-control-lg"
                        required
                    />
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <button class="btn btn-danger w-100 fw-bold fs-5 py-2">Sign Up</button>

                <p class="text-center text-muted signup-footer-text mt-3">
                    Already have an account? <a href="/login" class="text-danger fw-semibold">Log in</a>
                </p>

            </form>
        </div>
    </div>
</div>