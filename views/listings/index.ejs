<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/CSS/filters.css">

<div id="filter-row">

    <div id="filters">
        <div class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter <%= activeCategory === 'Rooms' ? 'active' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter <%= activeCategory === 'Iconic Cities' ? 'active' : '' %>">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter <%= activeCategory === 'Mountains' ? 'active' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter <%= activeCategory === 'Amazing Pools' ? 'active' : '' %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
            <div><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
        <div class="filter <%= activeCategory === 'Domes' ? 'active' : '' %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </div>
        <div class="filter <%= activeCategory === 'Boats' ? 'active' : '' %>">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>
    </div>

    <div id="filter-actions">
        <!-- Destination Popup -->
<div id="destination-popup" class="destination-popup d-none">
    <div class="destination-popup-content">
        <div class="popup-header">
            <h6>Search by destination</h6>
            <button id="close-popup-btn" type="button">&times;</button>
        </div>

        <input
            type="text"
            id="popup-search-input"
            placeholder="Search country or city"
            autocomplete="off"
        >

        <div id="selected-chips" class="selected-chips"></div>

        <ul id="destination-list"></ul>

        <div class="popup-footer">
            <button id="clear-selection-btn" type="button" class="popup-clear-btn">Clear all</button>
            <button id="apply-selection-btn" type="button" class="popup-apply-btn" disabled>
                Show listings
            </button>
        </div>
    </div>
</div>

        <div id="tax-toggle">
            <label for="flexSwitchCheckDefault">Display total price before taxes</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
            </div>
        </div>
    </div>
</div>

<% if (allListings.length === 0) { %>
    <div class="no-results">
        <i class="fa-solid fa-house-circle-xmark"></i>
        <p>
            No listings found for
            <b><%= activeCategory || search %></b>.
        </p>
        <a href="/listings">Clear search</a>
    </div>
<% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 listings-grid">
        <% for(let listing of allListings){ %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card h-100">
                        <img
                            src="<%= listing.image?.url || '/images/default.jpg' %>"
                            class="card-img-top"
                            alt="listing_image"
                        >
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b><br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %> per night
                                <span class="tax-info" style="display:none;">
                                    &nbsp;+ &#8377;<%= Math.round(listing.price * 0.18).toLocaleString("en-IN") %> taxes
                                </span>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    // Filter click
    document.querySelectorAll(".filter").forEach(filter => {
        filter.addEventListener("click", () => {
            const category = filter.querySelector("p").textContent.trim();
            const current = new URLSearchParams(window.location.search).get("category");
            if (current === category) {
                window.location.href = "/listings";
            } else {
                window.location.href = `/listings?category=${encodeURIComponent(category)}`;
            }
        });
    });

    // Tax toggle
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("change", () => {
        document.querySelectorAll(".tax-info").forEach(info => {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        });
    });

    // Scroll buttons (guarded — these elements may not exist on this page)
    const filtersEl = document.getElementById("filters");
    const scrollLeftBtn = document.getElementById("scroll-left");
    const scrollRightBtn = document.getElementById("scroll-right");

    if (scrollLeftBtn) {
        scrollLeftBtn.addEventListener("click", () => {
            filtersEl.scrollBy({ left: -200, behavior: "smooth" });
        });
    }
    if (scrollRightBtn) {
        scrollRightBtn.addEventListener("click", () => {
            filtersEl.scrollBy({ left: 200, behavior: "smooth" });
        });
    }

    const updateScrollBtns = () => {
        if (!scrollLeftBtn || !scrollRightBtn) return;
        scrollLeftBtn.style.display = filtersEl.scrollLeft > 0 ? "flex" : "none";
        scrollRightBtn.style.display = filtersEl.scrollLeft + filtersEl.clientWidth < filtersEl.scrollWidth ? "flex" : "none";
    };
    filtersEl.addEventListener("scroll", updateScrollBtns);
    updateScrollBtns(); // run on load

    // ===== Destination Popup =====
    // ===== Destination Popup (multi-select) =====
const filtersBtn = document.getElementById("filters-btn");
const popup = document.getElementById("destination-popup");
const popupSearchInput = document.getElementById("popup-search-input");
const destinationList = document.getElementById("destination-list");
const closePopupBtn = document.getElementById("close-popup-btn");
const selectedChipsEl = document.getElementById("selected-chips");
const applyBtn = document.getElementById("apply-selection-btn");
const clearBtn = document.getElementById("clear-selection-btn");

let allDestinations = [];
let selectedDestinations = [];

filtersBtn.addEventListener("click", async (e) => {
    e.stopPropagation();
    popup.classList.toggle("d-none");

    if (!popup.classList.contains("d-none") && allDestinations.length === 0) {
        try {
            const res = await fetch("/listings/destinations");
            const data = await res.json();
            allDestinations = [...new Set([...data.countries, ...data.locations])].sort();
            renderList(allDestinations);
        } catch (err) {
            destinationList.innerHTML = `<li class="no-match">Couldn't load destinations</li>`;
        }
    }
});

closePopupBtn.addEventListener("click", () => {
    popup.classList.add("d-none");
});

document.addEventListener("click", (e) => {
    if (!popup.contains(e.target) && e.target !== filtersBtn) {
        popup.classList.add("d-none");
    }
});

popupSearchInput.addEventListener("input", () => {
    const query = popupSearchInput.value.trim().toLowerCase();
    const filtered = allDestinations.filter(
        d => d.toLowerCase().includes(query) && !selectedDestinations.includes(d)
    );
    renderList(filtered);
});

function renderList(items) {
    destinationList.innerHTML = "";
    if (items.length === 0) {
        destinationList.innerHTML = `<li class="no-match">No matches found</li>`;
        return;
    }
    items.forEach(item => {
        const li = document.createElement("li");
        li.textContent = item;
        li.addEventListener("click", () => selectDestination(item));
        destinationList.appendChild(li);
    });
}

function selectDestination(item) {
    if (selectedDestinations.includes(item)) return;
    selectedDestinations.push(item);
    renderChips();
    // Remove it from the suggestion list and refresh
    const query = popupSearchInput.value.trim().toLowerCase();
    const filtered = allDestinations.filter(
        d => d.toLowerCase().includes(query) && !selectedDestinations.includes(d)
    );
    renderList(filtered);
}

function removeDestination(item) {
    selectedDestinations = selectedDestinations.filter(d => d !== item);
    renderChips();
    const query = popupSearchInput.value.trim().toLowerCase();
    const filtered = allDestinations.filter(
        d => d.toLowerCase().includes(query) && !selectedDestinations.includes(d)
    );
    renderList(filtered);
}

function renderChips() {
    selectedChipsEl.innerHTML = "";
    selectedDestinations.forEach(item => {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.innerHTML = `${item} <button type="button" aria-label="Remove">&times;</button>`;
        chip.querySelector("button").addEventListener("click", () => removeDestination(item));
        selectedChipsEl.appendChild(chip);
    });
    applyBtn.disabled = selectedDestinations.length === 0;
}

clearBtn.addEventListener("click", () => {
    selectedDestinations = [];
    renderChips();
    renderList(allDestinations);
});

applyBtn.addEventListener("click", () => {
    if (selectedDestinations.length === 0) return;
    const query = selectedDestinations.join(",");
    window.location.href = `/listings?search=${encodeURIComponent(query)}`;
});
</script>