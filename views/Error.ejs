        <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center" role="alert">

            <i class="fa-solid fa-triangle-exclamation fa-3x mb-3"></i>

            <h3 class="mb-3">
                Oops! Something went wrong
            </h3>

            <p class="mb-4 text-muted">
