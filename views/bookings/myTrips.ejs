<% layout("/layouts/boilerplate") %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
  <div>
    <h1 class="h2 fw-bold mb-1">My trips</h1>
    <p class="text-muted mb-0">Your upcoming and past stays in one place.</p>
  </div>
  <a href="/listings" class="btn btn-outline-secondary">Explore stays</a>
</div>

<% if (!bookings.length) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fa-solid fa-suitcase-rolling text-muted fa-2x mb-3"></i>
      <h2 class="h5 fw-bold">No trips yet</h2>
      <p class="text-muted">Find a place for your next getaway.</p>
      <a href="/listings" class="btn book-now-btn px-4">Explore stays</a>
    </div>
  </div>
<% } else { %>
  <div class="row g-3">
    <% for (const booking of bookings) { %>
      <div class="col-12">
        <article class="card border-0 shadow-sm overflow-hidden">
          <div class="row g-0">
            <div class="col-12 col-md-4">
              <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                <img
                  src="<%= booking.listing.image.url %>"
                  class="w-100 h-100"
                  style="min-height: 220px; object-fit: cover;"
                  alt="<%= booking.listing.title %>"
                  data-image-fallback
                >
              <% } else { %>
                <img src="/images/listing-placeholder.svg" class="w-100 h-100" style="min-height: 220px; object-fit: cover;" alt="Stay image unavailable">
              <% } %>
            </div>
            <div class="col-12 col-md-8">
              <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                  <div>
                    <h2 class="h5 fw-bold mb-1"><%= booking.listing ? booking.listing.title : "Listing no longer available" %></h2>
                    <% if (booking.listing) { %>
                      <p class="text-muted mb-0"><%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %></p>
                    <% } %>
                  </div>
                  <% if (booking.status === "confirmed") { %>
                    <span class="badge text-bg-success">Confirmed</span>
                  <% } else if (booking.status === "pending") { %>
                    <span class="badge text-bg-warning">Payment pending</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary">Cancelled</span>
                  <% } %>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-sm-6">
                    <div class="small text-muted">Check-in</div>
                    <div class="fw-semibold"><%= booking.checkIn.toLocaleDateString("en-IN", { dateStyle: "medium", timeZone: "UTC" }) %></div>
                  </div>
                  <div class="col-sm-6">
                    <div class="small text-muted">Check-out</div>
                    <div class="fw-semibold"><%= booking.checkOut.toLocaleDateString("en-IN", { dateStyle: "medium", timeZone: "UTC" }) %></div>
                  </div>
                  <div class="col-sm-6">
                    <div class="small text-muted">Guests</div>
                    <div class="fw-semibold"><%= booking.guests %></div>
                  </div>
                  <div class="col-sm-6">
                    <div class="small text-muted">Total</div>
                    <div class="fw-semibold">₹<%= booking.totalPrice.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                  </div>
                </div>

                <% if (booking.listing) { %>
                  <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-secondary btn-sm">View listing</a>
                <% } %>
                <% if (booking.status === "confirmed") { %>
                  <a href="/bookings/<%= booking._id %>/success" class="btn book-now-btn btn-sm ms-1">View confirmation</a>
                <% } %>
              </div>
            </div>
          </div>
        </article>
      </div>
    <% } %>
  </div>
<% } %>