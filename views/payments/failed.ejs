<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body p-4 p-md-5">
        <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 72px; height: 72px;">
          <i class="fa-solid fa-xmark fa-2x"></i>
        </div>
        <h1 class="h3 fw-bold mb-2">Payment wasn't completed</h1>
        <p class="text-muted mb-4">
          No booking confirmation was created. You can return to the listing and try again.
        </p>

        <% if (listing) { %>
          <a href="/listings/<%= listing._id %>" class="btn book-now-btn px-4 py-2">Return to listing</a>
        <% } else { %>
          <a href="/listings" class="btn book-now-btn px-4 py-2">Browse stays</a>
        <% } %>
        <a href="/bookings/my-trips" class="btn btn-outline-secondary px-4 py-2 ms-2">My trips</a>
      </div>
    </div>
  </div>
</div>