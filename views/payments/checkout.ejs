<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm overflow-hidden">
      <div class="card-body p-4 p-md-5">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-muted">
          <i class="fa-solid fa-arrow-left me-2"></i>Back to listing
        </a>

        <div class="d-flex align-items-center gap-3 mt-4 mb-4">
          <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
            <i class="fa-solid fa-lock"></i>
          </div>
          <div>
            <h1 class="h3 fw-bold mb-1">Complete your payment</h1>
            <p class="text-muted mb-0">Your booking is confirmed after payment is verified.</p>
          </div>
        </div>

        <div class="border rounded-3 p-3 p-md-4 mb-4">
          <h2 class="h5 fw-bold mb-3"><%= listing.title %></h2>
          <div class="row g-3 text-muted">
            <div class="col-sm-6">
              <div class="small">Check-in</div>
              <div class="text-dark fw-semibold"><%= booking.checkIn.toLocaleDateString("en-IN", { dateStyle: "medium", timeZone: "UTC" }) %></div>
            </div>
            <div class="col-sm-6">
              <div class="small">Check-out</div>
              <div class="text-dark fw-semibold"><%= booking.checkOut.toLocaleDateString("en-IN", { dateStyle: "medium", timeZone: "UTC" }) %></div>
            </div>
            <div class="col-sm-6">
              <div class="small">Guests</div>
              <div class="text-dark fw-semibold"><%= booking.guests %></div>
            </div>
            <div class="col-sm-6">
              <div class="small">Total</div>
              <div class="text-dark fw-bold">₹<%= booking.totalPrice.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
            </div>
          </div>
        </div>

        <div id="payment-message" class="alert alert-danger d-none" role="alert"></div>
        <button
          id="pay-button"
          type="button"
          class="btn book-now-btn w-100 py-3"
          data-key="<%= razorpayKeyId %>"
          data-amount="<%= order.amount %>"
          data-currency="<%= order.currency %>"
          data-order-id="<%= order.id %>"
          data-booking-id="<%= booking._id %>"
          data-listing-title="<%= listing.title %>"
          data-name="<%= user.username || user.email %>"
          data-email="<%= user.email || '' %>"
        >
          Pay ₹<%= booking.totalPrice.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </button>
        <p class="text-muted small text-center mt-3 mb-0">
          Payments are securely processed by Razorpay. Your booking is not confirmed until payment succeeds.
        </p>

        <form id="verify-payment-form" action="/payments/verify" method="POST" class="d-none">
          <input type="hidden" name="bookingId" value="<%= booking._id %>">
          <input type="hidden" name="razorpay_order_id" value="<%= order.id %>">
          <input type="hidden" name="razorpay_payment_id">
          <input type="hidden" name="razorpay_signature">
        </form>
        <form id="failed-payment-form" action="/payments/failed" method="POST" class="d-none">
          <input type="hidden" name="bookingId" value="<%= booking._id %>">
          <input type="hidden" name="orderId" value="<%= order.id %>">
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (() => {
    const button = document.getElementById("pay-button");
    const message = document.getElementById("payment-message");
    const verificationForm = document.getElementById("verify-payment-form");
    const failureForm = document.getElementById("failed-payment-form");

    button.addEventListener("click", () => {
      if (typeof window.Razorpay !== "function") {
        message.textContent = "The payment window could not be loaded. Refresh the page and try again.";
        message.classList.remove("d-none");
        return;
      }

      const checkout = new window.Razorpay({
        key: button.dataset.key,
        amount: button.dataset.amount,
        currency: button.dataset.currency,
        order_id: button.dataset.orderId,
        name: "Airbnb",
        description: `Booking: ${button.dataset.listingTitle}`,
        prefill: {
          name: button.dataset.name,
          email: button.dataset.email
        },
        theme: { color: "#ff385c" },
        handler: (response) => {
          verificationForm.elements.razorpay_payment_id.value = response.razorpay_payment_id;
          verificationForm.elements.razorpay_signature.value = response.razorpay_signature;
          verificationForm.submit();
        }
      });

      checkout.on("payment.failed", () => failureForm.submit());
      checkout.open();
    });
  })();
</script>