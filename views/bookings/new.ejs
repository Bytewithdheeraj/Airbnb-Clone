<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-muted">
          <i class="fa-solid fa-arrow-left me-2"></i>Back to listing
        </a>
        <h1 class="h3 fw-bold mt-4 mb-2">Request to book</h1>
        <p class="text-muted mb-4"><%= listing.title %></p>

        <div class="d-flex justify-content-between border-top border-bottom py-3 mb-4">
          <span class="fw-semibold">₹<%= listing.price.toLocaleString("en-IN") %> per night</span>
          <span><%= listing.location %>, <%= listing.country %></span>
        </div>

        <form action="/bookings/<%= listing._id %>" method="POST">
          <div class="row">
            <div class="col-sm-6 mb-3">
              <label for="check-in" class="form-label fw-semibold">Check-in</label>
              <input id="check-in" name="checkIn" type="date" class="form-control" required>
            </div>
            <div class="col-sm-6 mb-3">
              <label for="check-out" class="form-label fw-semibold">Check-out</label>
              <input id="check-out" name="checkOut" type="date" class="form-control" required>
            </div>
          </div>
          <div class="mb-4">
            <label for="guests" class="form-label fw-semibold">Guests</label>
            <input id="guests" name="guests" type="number" class="form-control" min="1" value="1" required>
          </div>
          <button type="submit" class="btn book-now-btn w-100 py-3">Confirm booking</button>
        </form>
      </div>
    </div>
  </div>
</div>