<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/CSS/login.css" />

<div class="login-page-wrapper">
    <div class="login-bg">
        <div class="login-card">

            <!-- Airbnb Logo -->
            <img src="/Assets/airbnb.png" class="login-logo" alt="logo" />

            <h4 class="text-center fw-bold">Log in</h4>

            <form action="/login" method="POST" class="needs-validation" novalidate>

                <div class="form-group">
                    <input
                        name="username"
                        id="username"
                        type="text"
                        placeholder="Username"
                        class="form-control form-control-lg"
                        required
                    />
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <div class="form-group">
                    <input
                        name="password"
                        id="password"
                        type="password"
                        placeholder="Password"
                        class="form-control form-control-lg"
                        required
                    />
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <button class="btn btn-danger w-100 fw-bold fs-5">Continue</button>

                <p class="text-center text-muted login-footer-text">
                    Don't have an account? <a href="/signup" class="text-danger fw-semibold">Sign up</a>
                </p>

            </form>
        </div>
    </div>
</div>